<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Camera: required by Hardened Runtime so TCC can grant camera access -->
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- Microphone: required by Hardened Runtime so TCC can grant microphone access -->
	<key>com.apple.security.device.microphone</key>
	<true/>

	<!-- App Sandbox is intentionally omitted.
	     Sandbox requires a paid Apple Developer account for distribution.
	     Without sandbox: network, file system, and IOKit access are unrestricted,
	     so no additional entitlements are needed for Pushover or video recording. -->
</dict>
</plist>
